# =====================================================================
# Rehab Elite - plantilla de variables de entorno
# Copiar a .env (en la raiz del repositorio) y completar los TODO.
# Formato .properties: sin comillas y SIN comentarios al final de linea.
# =====================================================================

# TODO: reemplazar rehab_elite por el nombre real de tu base si es distinto (host/puerto tambien)
DB_URL=jdbc:postgresql://localhost:5432/rehab_elite
# TODO: reemplazar por el usuario de PostgreSQL dueno de la base rehab_elite
DB_USERNAME=rehab_app
# TODO: reemplazar por la contrasena real de ese usuario
DB_PASSWORD=cambiar_esta_clave
# Nombre de la base del contenedor Docker (docker-compose.yml, puerto 5433). No afecta al PostgreSQL de Windows
POSTGRES_DB=rehab_elite

# TODO: reemplazar por un secreto aleatorio de al menos 32 caracteres (PowerShell: -join ((1..48) | % { '{0:x2}' -f (Get-Random -Max 256) }))
JWT_SECRET=reemplazar-por-un-secreto-aleatorio-de-al-menos-32-caracteres
JWT_EXPIRATION_MINUTES=30

# Cuenta inicial de la direccion operativa (MEJ-05): se crea al arrancar solo si no existe una direccion operativa activa.
# La direccion registra al personal, incluida la recepcion. El correo no debe pertenecer a otra cuenta.
# TODO: reemplazar por el correo de la direccion operativa inicial
INITIAL_DIRECTOR_EMAIL=direccion@rehabelite.local
# TODO: reemplazar por la clave inicial de la direccion operativa (cambiarla tras el primer ingreso)
INITIAL_DIRECTOR_PASSWORD=Cambiar.Esta.Clave.2026

# TODO: reemplazar por tu API key de Anthropic (se usa desde el Sprint 6; puede quedar vacia hasta entonces)
ANTHROPIC_API_KEY=

CORS_ALLOWED_ORIGINS=http://localhost:4200

# Solo perfil dev (datos sinteticos de desarrollo, ver README): contrasena comun de las cuentas del seed.
# Se guarda cifrada con BCrypt al arrancar; nunca la uses fuera de desarrollo.
# TODO: reemplazar por una contrasena de desarrollo de al menos 8 caracteres con letras y numeros
DEV_SEED_PASSWORD=Dev.Seed.Cambiar2026

# --- Correo (MEJ-01: activacion de cuentas y restablecimiento de contrasena) ---
# En desarrollo: Mailpit de docker-compose (docker compose --profile dev up -d mailpit), SMTP en 1025 sin usuario;
# los correos se ven en http://localhost:8025
# TODO: reemplazar por el servidor SMTP real en produccion
MAIL_HOST=localhost
# TODO: reemplazar por el puerto SMTP real (587 con STARTTLS en la mayoria de proveedores)
MAIL_PORT=1025
# TODO: reemplazar por el usuario SMTP real (vacio para Mailpit)
MAIL_USERNAME=
# TODO: reemplazar por la contrasena o clave de API SMTP real (vacia para Mailpit)
MAIL_PASSWORD=
# TODO: reemplazar por el remitente real de los correos de la clinica. En produccion debe ser de un dominio propio verificado en Brevo (no gmail.com ni outlook.com), ver docs/deployment/correo.md
MAIL_FROM=no-reply@rehabelite.local
# --- Transporte del correo (TEC-16) ---
# smtp (o vacio): servidor de MAIL_HOST/MAIL_PORT, como Mailpit en desarrollo.
# api: API HTTP de Brevo, para produccion en Render (ver docs/deployment/correo.md).
# TODO: reemplazar por api en produccion (Render); dejar vacio o smtp en desarrollo
MAIL_TRANSPORT=
# Clave de la API de Brevo (Brevo > SMTP & API > API Keys). Obligatoria con MAIL_TRANSPORT=api; vacia en desarrollo.
# TODO: reemplazar por la API key real de Brevo en produccion (nunca subirla a Git)
BREVO_API_KEY=
# URL publica del frontend: los enlaces de los correos apuntan a {APP_FRONTEND_URL}/activar-cuenta y /restablecer-contrasena
# TODO: reemplazar por la URL publica del frontend en produccion
APP_FRONTEND_URL=http://localhost:4200
