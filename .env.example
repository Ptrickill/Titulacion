# =====================================================================
# Rehab Elite - plantilla de variables de entorno
# Copiar a .env (en la raiz del repositorio) y completar los TODO.
# Formato .properties: sin comillas y SIN comentarios al final de linea.
# =====================================================================

# TODO: reemplazar rehab_elite por el nombre real de tu base si es distinto (host/puerto tambien)
DB_URL=jdbc:postgresql://localhost:5432/rehab_elite
# TODO: reemplazar por el usuario de PostgreSQL dueno de la base rehab_elite
DB_USERNAME=rehab_app
# TODO: reemplazar por la contrasena real de ese usuario
DB_PASSWORD=cambiar_esta_clave
# Nombre de la base del contenedor Docker (docker-compose.yml, puerto 5433). No afecta al PostgreSQL de Windows
POSTGRES_DB=rehab_elite

# TODO: reemplazar por un secreto aleatorio de al menos 32 caracteres (PowerShell: -join ((1..48) | % { '{0:x2}' -f (Get-Random -Max 256) }))
JWT_SECRET=reemplazar-por-un-secreto-aleatorio-de-al-menos-32-caracteres
JWT_EXPIRATION_MINUTES=30

# TODO: reemplazar por el correo del administrador inicial
ADMIN_EMAIL=admin@rehabelite.local
# TODO: reemplazar por la clave inicial del administrador (cambiarla tras el primer ingreso)
ADMIN_PASSWORD=Cambiar.Esta.Clave.2026

# TODO: reemplazar por tu API key de Anthropic (se usa desde el Sprint 7; puede quedar vacia hasta entonces)
ANTHROPIC_API_KEY=

CORS_ALLOWED_ORIGINS=http://localhost:4200
